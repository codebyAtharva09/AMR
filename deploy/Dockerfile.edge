# Multi-arch image for Raspberry Pi 4 (arm64) / Jetson (arm64) / x86 dev boxes.
#   docker buildx build --platform linux/arm64 -f deploy/Dockerfile.edge -t edgeswarm-edge .
# Not tested on physical hardware by the authors of this commit (see docs/LIMITATIONS.md).
FROM python:3.11-slim
WORKDIR /app
COPY deploy/requirements-edge.txt /app/deploy/requirements-edge.txt
RUN pip install --no-cache-dir -r deploy/requirements-edge.txt
COPY src /app/src
COPY models /app/models
COPY deploy /app/deploy
# The simulator map loader reuses the legacy warehouse model
CMD ["python3", "deploy/edge_benchmark.py", "--robots", "10"]
